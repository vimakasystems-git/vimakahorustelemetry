# Prefer: node scripts/configure.mjs
# Generates independent random credentials, never overwrites an existing .env.
HORUS_API_TOKEN=replace-with-at-least-32-random-characters
HORUS_ENABLE_DEMO=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-password
POSTGRES_PASSWORD=replace-with-another-random-password
